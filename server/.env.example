# ============================================================
# EcoAI server configuration — copy to server/.env and fill in.
# On a host (Render etc.) set the same names as environment
# variables instead; they override this file.
# See DEPLOY.md for a step-by-step production setup.
# ============================================================

# Port the server listens on (hosts like Render set this for you)
PORT=5000

# Where people open the website. Used in email links, and allowed to call the API.
#   one server:            https://ecoai.onrender.com
#   frontend on Vercel:    https://ecoai.vercel.app
PUBLIC_URL=http://localhost:5000

# Where this API is reachable, only needed when the website is on another domain.
# Render fills this in automatically (RENDER_EXTERNAL_URL), so you can leave it empty there.
SERVER_URL=

# Serve the built React app (frontend/dist) from this server. Set to false when the
# frontend is hosted separately (Vercel). Defaults to true if frontend/dist exists.
SERVE_FRONTEND=

# Extra origins allowed to call the API, comma separated. PUBLIC_URL is always allowed.
# Wildcards work for preview deployments, e.g. https://ecoai-*.vercel.app
CORS_ORIGINS=

# --- MongoDB -------------------------------------------------
# Leave empty during development to use an embedded local MongoDB
# (data persists in server/.data/db). Required in production.
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecoai
MONGODB_URI=
# Database name used when the URI does not include one
MONGODB_DB=ecoai

# --- Auth ----------------------------------------------------
# Long random string (production requires 32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin account. On startup, if no account uses ADMIN_EMAIL yet, one is created
# with this password (10+ characters). Handy on hosts without a shell (Render free).
# Remove ADMIN_PASSWORD once you've signed in at /admin/login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=EcoAI Admin

# Google sign-in / sign-up
# 1. https://console.cloud.google.com/apis/credentials -> Create credentials -> OAuth client ID
# 2. Application type: Web application
# 3. Authorized JavaScript origins: http://localhost:5000 and your website's URL
# 4. Paste the Client ID here (no client secret needed)
GOOGLE_CLIENT_ID=

# --- AI ------------------------------------------------------
# OpenAI powers GreenBot chat, the dumping-photo check and the food-photo check/autofill.
# Create a key at https://platform.openai.com/api-keys (the account needs billing/credit).
OPENAI_API_KEY=
# Any vision-capable chat model. gpt-6-luna is OpenAI's low-cost model; others work too.
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high — lower is faster and cheaper (ignored by non-reasoning models)
OPENAI_REASONING_EFFORT=low
# Only for OpenAI-compatible services (e.g. Azure OpenAI, OpenRouter)
OPENAI_BASE_URL=

# Optional fallbacks, used only when OPENAI_API_KEY is empty:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GOOGLE_CLOUD_VISION_API_KEY=

# --- Photos --------------------------------------------------
# Uploaded photos are stored in MongoDB by default, so they survive redeploys on hosts
# with a temporary disk (Render free). For a CDN, add a free Cloudinary account:
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Force a driver: mongo | cloudinary | local (disk: server/uploads)
STORAGE=

# --- Email ---------------------------------------------------
# Used for approval emails, authority alerts, NGO food alerts and status updates.
# Pick ONE provider. Render's free plan blocks SMTP, so use Brevo or Resend there.
#
# Brevo (free, 300 emails/day, no domain needed): https://app.brevo.com -> SMTP & API -> API keys
BREVO_API_KEY=
# Resend (needs a verified domain to email other people): https://resend.com/api-keys
RESEND_API_KEY=
#
# SMTP, e.g. Gmail with an App Password (https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
#
# Sender address. With Brevo it must be a sender you verified in Brevo.
MAIL_FROM=
MAIL_FROM_NAME=EcoAI
# Set to false to switch email off without removing the settings above.
MAIL_ENABLED=true

# Receives high-confidence illegal dumping reports
AUTHORITY_EMAIL=
# Receives AI-verified fresh food alerts (in addition to nearby registered NGOs)
NGO_EMAIL=

# --- Proxies -------------------------------------------------
# Number of proxies in front of the app (for correct client IPs). Rarely needs changing.
TRUST_PROXY=1
# Header carrying the visitor's real IP. Defaults to cf-connecting-ip on Render.
CLIENT_IP_HEADER=
