# Only needed when the frontend is hosted separately from the API (e.g. Vercel + Render).
# Copy to frontend/.env.production.local, or set it in Vercel -> Settings -> Environment Variables.
# It is read at BUILD time: redeploy the frontend after changing it.
#
# The URL of your EcoAI server, without a trailing slash:
VITE_API_URL=https://your-ecoai-api.onrender.com
